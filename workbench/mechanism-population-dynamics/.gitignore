# Run logs, queue/claim dirs and stdout captures inside result folders (process artifacts, not results)
**/results/**/logs/
**/results/**/claims/
**/results/**/*.out
**/results/**/*.log
**/results/**/*.pid
**/results/**/*.lock

# Regenerable local machine artifacts
__pycache__/
*.pyc
.nfs*

# Heads: E68 per-model weight samples and SeedPrints fingerprints (2.4 GB; regenerate with heads/scripts/e68_baselines.py)
heads/results/e68/*.npz

# MoE: raw arrays, checkpoints, per-sequence dumps and launch records stay local (see moe/ASSETS.md)
moe/results/**/*.pt
moe/results/**/*.npz
moe/results/**/*.npy
moe/results/**/*.jsonl
moe/results/**/*_launch.json
moe/results/**/*_sequences.json
moe/results/**/*_pos.json
moe/results/**/*_preflight.json
moe/results/e121/r12_main_N1_pos.json
moe/results/e121/r12_main_N1_sense_*.json
moe/results/e125/*_final/training_summary.json
moe/results/e125/*_final/coverage_diagnostic.json
moe/results/e130/initializations.json
moe/results/e131/diagnostic_staging_attempt*.json
moe/results/e143/
