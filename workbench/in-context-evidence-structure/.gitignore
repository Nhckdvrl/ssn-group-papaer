# regenerable from scripts (deterministic seeds); see README 资产位置
data/*/rows.jsonl
scripts/**/__pycache__/
*.pyc
logs/run_*.log
logs/stage_*.log
logs/screen_*.log
scripts/vendor/
data/_*
data/*/attn_subset.jsonl
results/**/*.npz
# external raw data (download: see README §8) and process logs
data/dices/
data/smoke/
logs/smoke/
logs/anchor_*.log
logs/mech_*.log
logs/vals_*.log
logs/patch*.log
logs/build_*.log
# keep only code, docs, small summaries and figures in git; detailed outputs stay local (NFS)
results/**/*.jsonl
logs/*.log

# New native states remain local; small JSON summaries are versioned.
results/e5[89]/**/*.npy
results/e6[0-4]/**/*.npy
# Tokenized first-query layouts contain detailed raw text; regenerate from cards.
results/e65/**/query_layout.json
results/e66/**/layout.json
# Detailed token layouts and measured key offsets are local experimental assets.
results/e67/**/layout.json
results/e70/**/*.npy
